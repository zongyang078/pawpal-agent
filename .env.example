# Copy this to .env, fill in one key, and source it:
#
#     cp .env.example .env
#     $EDITOR .env
#     source .env
#
# .env is gitignored. Keeping the key in a file rather than typing `export` in
# a terminal means it lives in exactly one place you can find, rotate, and
# delete -- and it never lands in your shell history.

# --- Provider: pick one. Anthropic wins if both are set. ---

# export ANTHROPIC_API_KEY=sk-ant-...
# export OPENAI_API_KEY=sk-...

# --- Optional: pin a model instead of the built-in default. ---
# Defaults are claude-sonnet-5 and gpt-4o-mini.

# export ANTHROPIC_MODEL=claude-opus-5
# export OPENAI_MODEL=gpt-4o
# export PAWPAL_MODEL=...    # applies to whichever provider is active
